{
  "openapi": "3.1.0",
  "info": {
    "title": "KeyStone",
    "description": "KeyStone server: ingest, scrape, per-node UI, living /help",
    "contact": {
      "name": "The KeyStone Authors"
    },
    "license": {
      "name": "GPL-2.0-or-later",
      "identifier": "GPL-2.0-or-later"
    },
    "version": "0.1.0"
  },
  "paths": {
    "/api/v1/catalog": {
      "get": {
        "tags": [
          "crate::http"
        ],
        "summary": "Metric catalog allowlist compiled into this binary.",
        "operationId": "catalog_api",
        "responses": {
          "200": {
            "description": "Catalog",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CatalogApi"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/nodes/{id}/dashboard": {
      "get": {
        "tags": [
          "crate::http"
        ],
        "summary": "Layout JSON plus hydrated widget values. PUT saves a custom per-node layout.",
        "operationId": "dashboard_get",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Dashboard layout and widgets",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/NodeDashboardApi"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "crate::http"
        ],
        "summary": "Save a custom per-node dashboard layout.",
        "operationId": "dashboard_put",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Saved"
          },
          "400": {
            "description": "Invalid layout"
          },
          "404": {
            "description": "Unknown node"
          }
        }
      },
      "delete": {
        "tags": [
          "crate::http"
        ],
        "summary": "Clear a custom layout so the built-in default is used again.",
        "operationId": "dashboard_delete",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "description": "Node id",
            "required": true,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "204": {
            "description": "Reset to default"
          },
          "404": {
            "description": "Unknown node"
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CatalogApi": {
        "type": "object",
        "required": [
          "metrics"
        ],
        "properties": {
          "metrics": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/CatalogMetric"
            }
          }
        }
      },
      "CatalogMetric": {
        "type": "object",
        "required": [
          "name",
          "metric_type",
          "unit",
          "help",
          "labels"
        ],
        "properties": {
          "help": {
            "type": "string"
          },
          "labels": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "metric_type": {
            "type": "string"
          },
          "name": {
            "type": "string"
          },
          "unit": {
            "type": "string"
          }
        }
      },
      "NodeDashboardApi": {
        "type": "object",
        "required": [
          "source",
          "layout",
          "widgets"
        ],
        "properties": {
          "layout": {},
          "source": {
            "type": "string"
          },
          "widgets": {}
        }
      }
    }
  }
}