{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "ServerConfig",
  "description": "Server configuration. Source of truth for `docs/src/generated/server-config.md`.",
  "type": "object",
  "properties": {
    "auth": {
      "default": {
        "password_hash": "",
        "username": "admin"
      },
      "allOf": [
        {
          "$ref": "#/definitions/ServerAuth"
        }
      ]
    },
    "data_dir": {
      "description": "Data directory for SQLite, sessions, and the series store.",
      "default": "/var/lib/keystone",
      "type": "string"
    },
    "grpc_listen": {
      "description": "gRPC ingest listen address.",
      "default": "0.0.0.0:9100",
      "type": "string"
    },
    "http_listen": {
      "description": "HTTP UI and API listen address.",
      "default": "0.0.0.0:8080",
      "type": "string"
    },
    "ingest_token": {
      "description": "Shared ingest token. Agents must present this. It cannot mutate Docker.",
      "default": "",
      "type": "string"
    },
    "prometheus_scrape": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/PrometheusScrape"
      }
    },
    "retention_hours": {
      "description": "Series retention in hours.",
      "default": 168,
      "type": "integer",
      "format": "uint32",
      "minimum": 0.0
    },
    "snmp_scrape": {
      "default": [],
      "type": "array",
      "items": {
        "$ref": "#/definitions/SnmpScrape"
      }
    }
  },
  "definitions": {
    "PrometheusScrape": {
      "type": "object",
      "required": [
        "name",
        "url"
      ],
      "properties": {
        "interval_secs": {
          "default": 30,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "name": {
          "description": "Job name stored as the node_id if `node_id` is empty.",
          "type": "string"
        },
        "node_id": {
          "description": "Optional node id to attach samples to.",
          "default": "",
          "type": "string"
        },
        "url": {
          "description": "Exposition URL, for example `http://127.0.0.1:9100/metrics`.",
          "type": "string"
        }
      }
    },
    "ServerAuth": {
      "type": "object",
      "properties": {
        "password_hash": {
          "description": "Argon2id password hash. If empty, `KEYSTONE_ADMIN_PASSWORD` is hashed on first start.",
          "default": "",
          "type": "string"
        },
        "username": {
          "description": "Local admin username.",
          "default": "admin",
          "type": "string"
        }
      }
    },
    "SnmpScrape": {
      "type": "object",
      "required": [
        "name",
        "target"
      ],
      "properties": {
        "community": {
          "default": "public",
          "type": "string"
        },
        "interval_secs": {
          "default": 30,
          "type": "integer",
          "format": "uint64",
          "minimum": 0.0
        },
        "name": {
          "type": "string"
        },
        "node_id": {
          "default": "",
          "type": "string"
        },
        "target": {
          "description": "`host:port` (port defaults to 161 if omitted).",
          "type": "string"
        }
      }
    }
  }
}