[Unit]
Description=KeyStone server (UI and ingest)
Documentation=https://git.bigrangatech.com/Ranga/keystone
After=network-online.target
Wants=network-online.target
# Keep retrying after a boot race so a kernel/apt reboot does not leave the
# UI down until someone systemctl starts it by hand.
StartLimitIntervalSec=0

[Service]
Type=simple
User=keystone
Group=keystone
EnvironmentFile=-/etc/default/keystone-server
ExecStart=/usr/bin/keystone serve --config /etc/keystone/server.toml
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/keystone

[Install]
WantedBy=multi-user.target
