#
# Upgrade/install must never touch Docker Engine, /var/lib/docker, or the
# rest of the OS. No prune, compose down, recursive chown, or symlink follow.

set -e

# Own one directory inode we created. Never chown -R (a symlink or bind
# mount under /var/lib/keystone must not take the OS or Engine with it).
ks_prepare_state_dir() {
	dir=$1
	case "$dir" in
	/ | /var | /usr | /etc | /boot | /home | /var/lib | /var/lib/docker | /var/lib/docker/*)
		echo "keystone-agent: refusing to take ownership of $dir" >&2
		exit 1
		;;
	esac
	if [ -L "$dir" ]; then
		echo "keystone-agent: $dir is a symlink; refusing to chown through it" >&2
		exit 1
	fi
	if [ -e "$dir" ] && [ ! -d "$dir" ]; then
		echo "keystone-agent: $dir exists and is not a directory" >&2
		exit 1
	fi
	mkdir -p "$dir"
	if [ -L "$dir" ]; then
		echo "keystone-agent: $dir is a symlink; refusing to chown through it" >&2
		exit 1
	fi
	chown keystone:keystone "$dir"
	chmod 0750 "$dir"
}

# Config dir: the service user must *read* toml. 0750 root:root hides the
# file (Path::exists is false) and an older agent then dialed localhost.
# Own this inode only. Never chown -R.
ks_prepare_etc_keystone() {
	dir=/etc/keystone
	if [ -L "$dir" ]; then
		echo "keystone-agent: $dir is a symlink; refusing to chown through it" >&2
		exit 1
	fi
	if [ -e "$dir" ] && [ ! -d "$dir" ]; then
		echo "keystone-agent: $dir exists and is not a directory" >&2
		exit 1
	fi
	mkdir -p "$dir"
	if [ -L "$dir" ]; then
		echo "keystone-agent: $dir is a symlink; refusing to chown through it" >&2
		exit 1
	fi
	chown root:keystone /etc/keystone
	chmod 0750 /etc/keystone
}

# After the debhelper section: cargo-deb uses start=false so dh never starts
# a unit the operator disabled. If the unit is enabled for boot, it should be
# running. try-restart when already up (new binary). Start when enabled but
# down (first install, or a host reboot after an older package that never
# started). Never start a unit the operator disabled. Use deb-systemd-invoke
# (not the systemctl start substring). Never start keystone-sys here.
ks_start_if_enabled() {
	unit=$1
	if [ ! -d /run/systemd/system ]; then
		return 0
	fi
	if ! systemctl is-enabled --quiet "$unit" 2>/dev/null; then
		return 0
	fi
	if systemctl is-active --quiet "$unit" 2>/dev/null; then
		systemctl try-restart "$unit" || true
	else
		deb-systemd-invoke start "$unit" >/dev/null || true
	fi
}

case "$1" in
configure)
	if ! getent group keystone >/dev/null; then
		addgroup --system keystone
	fi
	if ! getent passwd keystone >/dev/null; then
		adduser --system --ingroup keystone --home /var/lib/keystone \
			--no-create-home --gecos "KeyStone" keystone
	fi
	ks_prepare_state_dir /var/lib/keystone
	ks_prepare_state_dir /var/lib/keystone/agent-buffer
	ks_prepare_etc_keystone
	if [ -f /etc/keystone/agent.toml ]; then
		chown root:keystone /etc/keystone/agent.toml
		chmod 0640 /etc/keystone/agent.toml
	fi
	# Group membership only. Does not start, stop, or prune containers.
	if getent group docker >/dev/null; then
		adduser keystone docker >/dev/null || true
	fi
	;;
esac

#DEBHELPER#

case "$1" in
configure)
	ks_start_if_enabled keystone-agent.service
	# Sys helper stays opt-in. If the operator already enabled the socket,
	# pick up the new binary. Never enable or start it when it was off.
	if [ -d /run/systemd/system ]; then
		if systemctl is-active --quiet keystone-sys.socket 2>/dev/null; then
			systemctl try-restart keystone-sys.socket || true
		elif systemctl is-active --quiet keystone-sys.service 2>/dev/null; then
			systemctl try-restart keystone-sys.service || true
		fi
	fi
	;;
esac

exit 0
