[Unit]
Description=KeyStone system-admin helper socket
Documentation=https://git.bigrangatech.com/Ranga/keystone
# Do not enable this unit from the package. The System tab shows:
#   sudo systemctl enable --now keystone-sys.socket

[Socket]
ListenStream=/run/keystone/sys.sock
SocketUser=root
SocketGroup=keystone
SocketMode=0660
DirectoryMode=0750
# Group= so /run/keystone is root:keystone and the agent can traverse it.
Group=keystone
RuntimeDirectory=keystone
RuntimeDirectoryMode=0750
RuntimeDirectoryPreserve=yes
Accept=false

[Install]
WantedBy=sockets.target
